# Supabase — copy to .env.local and fill in from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC; use in API routes / server.ts only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
